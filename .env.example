# ============================================================
# EventStyle – משתני סביבה לדוגמה
# העתיקי את הקובץ ל-.env ומלאי ערכים אמיתיים.
# אין להעלות את .env ל-GitHub!
# ============================================================

# development / production / test
NODE_ENV=development

# הפורט שעליו השרת מאזין (ב-Render הוא נקבע אוטומטית)
PORT=4000

# כתובת החיבור ל-PostgreSQL
# מקומי:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/eventstyle
# Neon:   postgresql://USER:PASSWORD@HOST.neon.tech/eventstyle?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/eventstyle"

# סוד לחתימת JWT – מחרוזת אקראית ארוכה (לפחות 32 תווים)
# ליצירה: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# תוקף ה-Token (לדוגמה 15m, 2h, 1d)
JWT_EXPIRES_IN=2h

# כתובות צד הלקוח המורשות (מופרדות בפסיק). לדוגמה ב-Vite:
CORS_ORIGIN=http://localhost:5173

# ---------- קוד אימות האימייל ----------
# אין שירות מיילים חיצוני: הקוד מודפס ביומן השרת (בטרמינל / ב-Logs של Render).
# console הוא הערך היחיד הנתמך.
EMAIL_PROVIDER=console

# ---------- אחסון תמונות (Cloudinary) ----------
# אם ריקים – העלאת תמונות תחזיר 503 (שאר המערכת עובדת)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- התחברות עם Google (רשות) ----------
# Client ID של אפליקציית Web ב-Google Cloud Console (מסתיים ב-.apps.googleusercontent.com).
# אינו סוד, אבל נשמר כאן כדי שיהיה קל להחליף. בלעדיו POST /api/auth/google מחזיר 503.
# הסבר מלא: docs/SERVICES-SETUP.md
GOOGLE_CLIENT_ID=

# ---------- Seed ----------
# ב-Production (NODE_ENV=production) נוצרים רק 3 החבילות הכלליות (כשאין חבילות) והמנהלת.
# לקוחות, אירועים, גלריה וחבילות לפי סוג אירוע הם נתוני הדגמה – רק בפיתוח.
SEED_ADMIN_EMAIL=admin@eventstyle.example
# בפיתוח: אם ריק, תיווצר סיסמת פיתוח. ב-Production חובה להגדיר!
SEED_ADMIN_PASSWORD=
# סיסמת לקוחות ההדגמה – פיתוח בלבד (ב-Production המשתנה מתעלם)
SEED_CLIENT_PASSWORD=
# false = לא ליצור חבילות הדגמה לפי סוג אירוע גם בפיתוח (ב-Production הן אף פעם לא נוצרות)
SEED_DEMO_PACKAGES=true
