// EventStyle – מבנה מסד הנתונים (PostgreSQL + Prisma)
// חמש טבלאות: Users, Events, EventPhotos, Packages, GalleryItems

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  Client
}

enum EventType {
  Birthday
  BatMitzvah
  Brit
  Corporate
  Private
}

enum EventStatus {
  New
  Planning
  Preparing
  Ready
  Completed
}

// סוג האחסון של תמונת אירוע ב-Cloudinary (תואם ל-ImageAccess בקוד):
// public = קישור ציבורי קבוע (התמונות הקיימות), authenticated = קובץ פרטי שנגיש רק בקישור חתום וזמני
enum PhotoStorageType {
  public
  authenticated
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @db.VarChar(100)
  // נשמר תמיד באותיות קטנות וללא רווחים
  email        String   @unique @db.VarChar(254)
  // רשות: משתמש שנרשם דרך Google לא מוסר טלפון (אפשר להוסיף בעריכת פרופיל)
  phone        String?  @db.VarChar(20)
  // רשות: כתובת שהמשתמש מוסיף בעריכת הפרופיל בלבד (null = אין כתובת)
  address      String?  @db.VarChar(200)
  // רשות: משתמש שנרשם דרך Google בלבד אין לו סיסמה מקומית
  passwordHash String?  @db.VarChar(100)
  // מזהה Google היציב (sub מתוך ה-ID Token). לא נשמרים טוקנים של Google
  googleId     String?  @unique @db.VarChar(255)
  role         Role     @default(Client)
  createdAt    DateTime @default(now())

  // אימות כתובת אימייל בקוד חד־פעמי (נשמר רק Hash של הקוד)
  emailVerified             Boolean   @default(false)
  verificationCodeHash      String?   @db.VarChar(64)
  verificationCodeExpiresAt DateTime?
  verificationAttempts      Int       @default(0)
  verificationLastSentAt    DateTime?
  verificationSendCount     Int       @default(0)
  verificationWindowStart   DateTime?

  events         Event[]
  uploadedPhotos EventPhoto[]

  @@map("Users")
}

model Package {
  id          Int        @id @default(autoincrement())
  // השם ייחודי בתוך אותו סוג אירוע. לחבילות כלליות (eventType = null) יש אינדקס ייחודי חלקי
  // שנוצר ב-Migration בלבד (Packages_general_name_key) – Prisma לא יודעת לתאר אותו כאן
  name        String     @db.VarChar(50)
  description String     @db.VarChar(500)
  // מחיר המחירון הנוכחי (הדגמה). אינו נשמר בהזמנות, ולכן שינוי שלו לא משנה הזמנות קיימות
  price       Decimal    @db.Decimal(10, 2)
  features    String[]
  imageUrl    String     @db.VarChar(500)
  // null = חבילה כללית שמתאימה לכל סוג אירוע
  eventType   EventType?
  // false = בארכיון: מוסתרת מהאתר הציבורי, אבל הזמנות קיימות ממשיכות להפנות אליה
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  events Event[]

  @@unique([eventType, name])
  @@index([eventType, isActive])
  @@map("Packages")
}

model Event {
  id            Int         @id @default(autoincrement())
  eventName     String      @db.VarChar(120)
  clientName    String      @db.VarChar(100)
  clientEmail   String      @db.VarChar(254)
  eventType     EventType
  eventDate     DateTime    @db.Date
  location      String      @db.VarChar(200)
  packageId     Int
  themeColor    String      @db.VarChar(30)
  guestCount    Int
  budget        Decimal     @db.Decimal(12, 2)
  status        EventStatus @default(New)
  coverImageUrl String?     @db.VarChar(500)
  notes         String?     @db.VarChar(2000)
  userId        Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  package Package      @relation(fields: [packageId], references: [id], onDelete: Restrict)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  photos  EventPhoto[]

  @@index([eventDate])
  @@index([status])
  @@index([eventType])
  @@index([packageId])
  @@index([userId])
  @@index([clientEmail])
  @@index([clientName])
  @@index([eventName])
  @@map("Events")
}

model EventPhoto {
  id             Int              @id @default(autoincrement())
  eventId        Int
  // בתמונה ציבורית: הקישור הקבוע. בתמונה authenticated לא נשמר קישור קבוע – הצפייה רק בקישור זמני
  url            String           @db.VarChar(500)
  publicId       String?          @db.VarChar(255)
  createdAt      DateTime         @default(now())
  // מי העלה את התמונה. null בתמונות ישנות ובמשתמש שנמחק (SetNull)
  uploadedById   Int?
  // ברירת המחדל public שומרת על משמעות התמונות הקיימות ועל ההעלאה הנוכחית של המנהלת
  storageType    PhotoStorageType @default(public)
  // הסכמת הלקוחה לאפשרות פרסום בגלריה. פרסום בפועל רק באישור מנהלת
  publishConsent Boolean          @default(false)
  // SHA-256 (hex) של הקובץ המעובד – למניעת העלאה כפולה לאותו אירוע. null בתמונות ישנות
  contentHash    String?          @db.Char(64)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy  User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  galleryItem GalleryItem?

  @@unique([eventId, contentHash])
  @@index([eventId])
  @@index([uploadedById])
  @@map("EventPhotos")
}

// הגלריה הציבורית: רק פריטים שהמנהלת העלתה (ובעתיד – גם תמונות לקוחות שהמנהלת אישרה, כעותק נפרד).
// תמונות לא מאושרות לעולם לא נשמרות כאן.
model GalleryItem {
  id                 Int         @id @default(autoincrement())
  title              String      @db.VarChar(120)
  category           EventType
  url                String      @db.VarChar(500)
  publicId           String?     @db.VarChar(255)
  // false = מוסתרת: לא מופיעה באף נתיב ציבורי (הקובץ עצמו נשאר ב-Cloudinary)
  isPublished        Boolean     @default(true)
  // תמונה מובילה (למשל לדף הבית ולתמונת השער של הגלריה)
  isFeatured         Boolean     @default(false)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  // תמונת האירוע שממנה נוצר עותק הגלריה (כשמנהלת מפרסמת תמונה של לקוחה). ייחודי – תמונה מתפרסמת פעם אחת.
  // SetNull: מחיקת תמונת המקור או האירוע לא מוחקת את פריט הגלריה אוטומטית; מדיניות המחיקה תיקבע בקוד באישור
  sourceEventPhotoId Int?        @unique
  sourceEventPhoto   EventPhoto? @relation(fields: [sourceEventPhotoId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([createdAt])
  @@index([category, isPublished, sortOrder])
  @@map("GalleryItems")
}
